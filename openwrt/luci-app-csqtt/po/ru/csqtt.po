msgid "CSQTT — клиент VPN-туннеля"
msgstr "CSQTT — клиент VPN-туннеля"

msgid "Клиент создаёт системный VPN и передаёт трафик роутера/LAN через TURN."
msgstr "Клиент создаёт системный VPN и передаёт трафик роутера/LAN через TURN."

msgid "Основные настройки"
msgstr "Основные настройки"

msgid "Включить сервис"
msgstr "Включить сервис"

msgid "Сервис стартует автоматически при загрузке роутера (init.d enable)."
msgstr "Сервис стартует автоматически при загрузке роутера (init.d enable)."

msgid "Режим работы"
msgstr "Режим работы"

msgid "TUN — трафик с lan_device уходит в туннель. SOCKS5 — локальный прокси без изменения маршрутов."
msgstr "TUN — трафик с lan_device уходит в туннель. SOCKS5 — локальный прокси без изменения маршрутов."

msgid "TUN (интернет в LAN)"
msgstr "TUN (интернет в LAN)"

msgid "SOCKS5 (локальный прокси)"
msgstr "SOCKS5 (локальный прокси)"

msgid "Сервер (peer)"
msgstr "Сервер (peer)"

msgid "Адрес CSQTT-сервера на VPS в формате host:port."
msgstr "Адрес CSQTT-сервера на VPS в формате host:port."

msgid "Пароль подключения"
msgstr "Пароль подключения"

msgid "Пароль, заданный на сервере. При старте переносится в credentials.json (0600)."
msgstr "Пароль, заданный на сервере. При старте переносится в credentials.json (0600)."

msgid "VK-хеши"
msgstr "VK-хеши"

msgid "Допустимые хеши VK-звонков через запятую."
msgstr "Допустимые хеши VK-звонков через запятую."

msgid "Имя устройства"
msgstr "Имя устройства"

msgid "Идентификатор роутера, видимый на сервере."
msgstr "Идентификатор роутера, видимый на сервере."

msgid "Потоков (workers)"
msgstr "Потоков (workers)"

msgid "Маскировка (obfs)"
msgstr "Маскировка (obfs)"

msgid "Тип RTP-потока, которым маскируется трафик."
msgstr "Тип RTP-потока, которым маскируется трафик."

msgid "TURN транспорт"
msgstr "TURN транспорт"

msgid "TURN хост"
msgstr "TURN хост"

msgid "Обычно пусто — адрес берётся из peer."
msgstr "Обычно пусто — адрес берётся из peer."

msgid "TURN порт"
msgstr "TURN порт"

msgid "TUN-интерфейс"
msgstr "TUN-интерфейс"

msgid "LAN интерфейс"
msgstr "LAN интерфейс"

msgid "Трафик этого интерфейса будет идти через туннель."
msgstr "Трафик этого интерфейса будет идти через туннель."

msgid "Маршрутизировать трафик LAN"
msgstr "Маршрутизировать трафик LAN"

msgid "Перехват трафика с lan_device в отдельную таблицу маршрутов."
msgstr "Перехват трафика с lan_device в отдельную таблицу маршрутов."

msgid "Номер таблицы маршрутов"
msgstr "Номер таблицы маршрутов"

msgid "SOCKS5 адрес прослушивания"
msgstr "SOCKS5 адрес прослушивания"

msgid "По умолчанию локальный 127.0.0.1:1080. Открывать на LAN — только с firewall-ограничениями."
msgstr "По умолчанию локальный 127.0.0.1:1080. Открывать на LAN — только с firewall-ограничениями."

