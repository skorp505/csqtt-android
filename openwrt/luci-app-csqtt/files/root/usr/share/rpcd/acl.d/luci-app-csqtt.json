{
    "luci-app-csqtt": {
        "description": "Grant access to CSQTT LuCI procedures",
        "read": {
            "uci": [ "csqtt" ],
            "service": [ "list" ],
            "file": {
                "/sbin/logread": [ "exec" ]
            }
        },
        "write": {
            "uci": [ "csqtt" ],
            "file": [ "exec" ],
            "rc": [ "init" ]
        }
    }
}